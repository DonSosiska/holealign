# Holealign agent configuration, installed as /etc/holealign/agent.yaml (root:holealign, mode 0640).
# Values shown are the defaults unless marked required. Unknown keys are ignored.
# Reference for every key: docs/configuration.md.

# Base URL of holealign-server (required). Must be https:// with a host and no user:password@.
# Redirects are never followed. TLS 1.2 or newer is required.
server_url: https://holealign.example.com

# Server identity (optional, recommended for private CAs and self-hosted servers).
# ca_file: PEM bundle. When set, ONLY these roots are trusted; system roots are not used.
# server_cert_sha256: hex SHA-256 fingerprints of the server leaf certificate's
# SubjectPublicKeyInfo. When set the handshake must present a leaf with one of these
# hashes IN ADDITION to normal chain validation (list the next key too before rotating).
# Get the value with `holealign-agent -print-server-pin` (validates the chain first; compare
# it out of band), or: openssl x509 -pubkey -noout -in server.pem | openssl pkey -pubin -outform DER | sha256sum
# ca_file: /etc/holealign/ca.pem
# server_cert_sha256: ["0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"]
# Optional mTLS client certificate (PEM paths):
# client_cert: /etc/holealign/client.pem
# client_key: /etc/holealign/client.key

# Permit an http:// server_url (testing only; the agent key travels unencrypted, a WARN is logged).
allow_insecure_http: false

# Enrollment token from `holealign-server token create <name>`. Only needed until the
# agent has enrolled. The agent has no environment override for it, so it lives in
# this file; keep the file mode 0600 (0640 root:holealign with the split services).
# After enrollment and the first successful check-in the root collector (or, in -mode all, the
# agent itself when it runs as root) rewrites this line as `enroll_token: ""`. The agent can then
# not re-enroll on its own: a host that lost its credentials needs a fresh token here.
enroll_token: "pt_replace-me"

# Labels select Matrix rooms on the server (see the label routes in the web UI). Lowercase,
# ^[a-z0-9][a-z0-9._-]{0,63}$, at most 32. Ignored when the enrollment token carries labels.
labels: [prod, web]

# Privilege separation (systemd install): the root collector listens on this unix socket and
# the unprivileged sender (user "holealign") connects to it. Ignored in `-mode all`.
# collector_socket: /run/holealign/collector.sock
# collector_user: holealign

# Where agent_id and agent_key are stored. Must match StateDirectory in the systemd unit.
state_dir: /var/lib/holealign-agent

# How often the agent checks in (facts, labels, OS).
checkin_interval: 5m

# Full host and image rescan. Changes to package databases trigger an earlier scan.
inventory_interval: 6h

# Docker API socket. Container images are scanned when the socket exists.
docker_socket: /var/run/docker.sock

# Also scan language packages (pip, npm, gems, ...), not only OS packages.
scan_language_packages: true

# Paths skipped by the filesystem scan.
exclude_paths: [/proc, /sys, /dev, /run, /var/lib/docker, /var/lib/containerd, /snap,
                /mnt, /media, /var/lib/containers, /var/lib/kubelet, /var/lib/lxc, /var/lib/lxd, /home/*/.cache]

# Per-scan time limits (a timeout or crash is reported as the agent.inventory_error fact).
host_scan_timeout: 10m
image_scan_timeout: 5m
