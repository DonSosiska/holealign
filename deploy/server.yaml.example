# Panoptes server configuration, installed as /etc/panoptes/server.yaml.
# Every key is optional; the values shown are the defaults.
# Secrets are never stored here: they come from environment variables
# (see server.env.example). Any scalar can also be set as PANOPTES_<SECTION>_<KEY>.

# Agent API listener (/api/v1/*, /healthz). Monitored hosts connect here; nothing else is served.
listen: ":8080"

# Admin web UI listener. Keep it on loopback (default) and reach it through an SSH tunnel, a VPN or
# a reverse proxy, so monitored hosts cannot reach the login page. Empty or equal to `listen`
# serves both on one port (legacy; logs a WARNING).
admin_listen: "127.0.0.1:8081"

# Public URL of the admin web UI, used for links in notifications.
public_url: "http://localhost:8081"

# Optional native TLS (both keys of a pair required; TLS 1.2 minimum). Alternative: terminate TLS
# in a reverse proxy.
# tls_cert: /etc/panoptes/agent.crt        # agent API
# tls_key: /etc/panoptes/agent.key
# admin_tls_cert: /etc/panoptes/admin.crt  # admin web UI
# admin_tls_key: /etc/panoptes/admin.key

# CIDRs / IPs of reverse proxies whose X-Forwarded-For header is trusted for the client address
# (rate limiting, audit log). Empty: always the TCP peer address. Never list networks that
# untrusted clients can reach directly. A WARN is logged for entries wider than /16 (IPv4) or /48
# (IPv6) and for 0.0.0.0/0 or ::/0.
trusted_proxies: []

# Growth limits. Resolved findings and notification dedup records older than this are deleted
# (daily, and once at start). 0 keeps them forever. Accepts d (days) and Go durations.
retention:
  resolved_findings: 30d
  notifications: 90d

# Per-host protection against one host starving or flooding the server (0 = unlimited).
limits:
  # Open findings kept per host; the lowest severities are dropped first (WARN + pipeline_error alert).
  findings_per_host: 20000
  # Cumulative matcher (Grype) time one host may use per rolling hour; runs of a host over budget are
  # deferred (WARN + pipeline_error alert).
  match_seconds_per_host_hour: 900

# SQLite database and Grype DB cache. Must match StateDirectory in the systemd unit.
data_dir: /var/lib/panoptes

# Shipped exploitability rules (YAML files).
rules_dir: /usr/share/panoptes/rules

feeds:
  # How often vulnerability data (Grype DB, KEV, EPSS) is refreshed.
  interval: 6h
  # false disables all network updates (air-gapped hosts, tests).
  update: true

# Silence alerts: an agent that stops checking in, a stale/failing vulnerability feed or a failing
# pipeline is reported to Matrix.
alerts:
  # Alert when a host has not checked in for this long. 0 disables agent_silent/agent_back.
  agent_silent_after: 30m
  # Alert when the vulnerability DB was not updated for this long (or refreshing keeps failing).
  # 0 disables feed_stale/feed_ok.
  feed_stale_after: 48h
  # Rooms for server-level events (feed, pipeline, mass silence). Empty: matrix.default_rooms.
  ops_rooms: []

matrix:
  # Homeserver for alerts, e.g. https://matrix.example.com. Empty disables Matrix.
  homeserver: ""
  # Name of the environment variable holding the bot's access token.
  access_token_env: PANOPTES_MATRIX_TOKEN
  # Rooms used when no label route matches, e.g. ["!abc:example.com"].
  default_rooms: []
  # Label to rooms. Web UI edits are stored in the database and merged with these.
  # Example:
  #   routes:
  #     - {label: prod, rooms: ["!prod:example.com"]}
  routes: []

llm:
  # none | anthropic | openai-compatible (e.g. Ollama)
  provider: none
  model: claude-sonnet-5-5
  # openai-compatible only, e.g. http://ollama:11434/v1
  base_url: ""
  # Name of the environment variable holding the API key.
  api_key_env: PANOPTES_LLM_API_KEY
  # Maximum rule-drafting calls per day.
  daily_limit: 50

# Agentless mode: the server monitors its own host without a separate panoptes-agent. The host
# appears as a normal host (findings, rules, alerts, silence alerts) labelled "server" and marked
# "local (built-in)" in the web UI. No enrollment token is used: the server creates the host record
# itself and stores the agent key in <data_dir>/local-agent/credentials.json (0600).
# If a standalone agent already enrolled this machine the server does NOT take the host over: it logs
# an ERROR (delete that host with `panoptes-server host delete <hostname>` or disable local_agent).
local_agent:
  # Off by default. Env: PANOPTES_LOCAL_AGENT_ENABLED.
  enabled: false
  # collector: read the host through the root collector's unix socket (recommended: the server stays
  #            unprivileged, the host runs only panoptes-collector.service; install.sh --collector-only;
  #            the server must run as the collector's user "panoptes", see panoptes-server.service).
  # inprocess: collect inside the server process with its own privileges (dev / single box). Fewer facts
  #            when not root (sshd -T, docker.sock ...; one WARN). In a container this scans the container.
  # auto:      collector when the socket answers, else inprocess (the choice is logged).
  source: auto
  collector_socket: /run/panoptes/collector.sock
  # Authoritative labels of the local host (locked like enrollment token labels). Changing them is
  # applied at the next server start.
  labels: [server]
  checkin_interval: 5m          # >= 1m
  inventory_interval: 6h        # >= 1m, safety-net rescan; package changes trigger earlier
  scan_language_packages: true
  # Paths excluded from the host scan; empty = the agent defaults (/proc, /sys, /dev, /run, /var/lib/docker, ...).
  # data_dir is always excluded in addition (the scanner must not open the server's own database files).
  exclude_paths: []
  docker_socket: /var/run/docker.sock   # images are scanned if it exists and is readable

# Names in *_env keys must match ^PANOPTES_[A-Z0-9_]+$ and be pairwise different (Matrix token, LLM
# key, admin password).
# A WARN is logged at startup for http:// public_url / matrix.homeserver / llm.base_url on
# non-loopback hosts.
admin:
  # Min 12 characters; PANOPTES_ADMIN_PASSWORD_FILE (path) is also honoured. Environment variable with the password for user "admin". Used only when no
  # web user exists yet (first start).
  initial_password_env: PANOPTES_ADMIN_PASSWORD
