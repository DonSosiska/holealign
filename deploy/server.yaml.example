# Holealign server configuration, installed as /etc/holealign/server.yaml.
# Every key is optional; the values shown are the defaults. Unknown keys are an error.
# Reference for every key: docs/configuration.md.
# Secrets are never stored here: they come from environment variables
# (see server.env.example). Any scalar can also be set as HOLEALIGN_<SECTION>_<KEY>.

# Agent API listener (/api/v1/*, /healthz). Monitored hosts connect here; nothing else is served.
listen: ":8080"

# Admin web UI listener. Keep it on loopback (default) and reach it through an SSH tunnel, a VPN or
# a reverse proxy, so monitored hosts cannot reach the login page. Empty or equal to `listen`
# serves both on one port (legacy; logs a WARNING).
admin_listen: "127.0.0.1:8081"

# Public URL of the admin web UI, used for links in notifications.
public_url: "http://localhost:8081"

# Optional native TLS (both keys of a pair required; TLS 1.2 minimum). Alternative: terminate TLS
# in a reverse proxy.
# tls_cert: /etc/holealign/agent.crt        # agent API
# tls_key: /etc/holealign/agent.key
# admin_tls_cert: /etc/holealign/admin.crt  # admin web UI
# admin_tls_key: /etc/holealign/admin.key

# CIDRs / IPs of reverse proxies whose X-Forwarded-For header is trusted for the client address
# (rate limiting, audit log). Empty: always the TCP peer address. Never list networks that
# untrusted clients can reach directly. A WARN is logged for entries wider than /16 (IPv4) or /48
# (IPv6) and for 0.0.0.0/0 or ::/0.
trusted_proxies: []

# Growth limits. Resolved findings and notification dedup records older than this are deleted
# (daily, and once at start). 0 keeps them forever. Accepts d (days) and Go durations.
retention:
  resolved_findings: 30d
  notifications: 90d

# Per-host protection against one host starving or flooding the server.
# findings_per_host and match_seconds_per_host_hour: 0 = unlimited.
# inventory_*: 0 = use the built-in default (the values shown).
limits:
  # Open findings kept per host, ranked after rule evaluation (exploitable first); findings over the
  # cap keep their previous state and are never reported as resolved (WARN + pipeline_error alert).
  findings_per_host: 20000
  # Cumulative matcher (Grype) time one host may use per rolling hour; runs of a host over budget are
  # deferred (WARN + pipeline_error alert).
  match_seconds_per_host_hour: 900
  # Inventory uploads per host, charged before the body is read (refill per minute, burst).
  inventory_attempts_per_minute: 10
  inventory_attempt_burst: 6
  # Inventory bodies decoded at once, server-wide; more get 503 with Retry-After.
  inventory_concurrent_decodes: 4

# SQLite database and Grype DB cache. Must match StateDirectory in the systemd unit.
data_dir: /var/lib/holealign

# Optional extra/override rule YAML files. The eight shipped rules are embedded in the binary, so
# this directory may be absent.
rules_dir: /usr/share/holealign/rules

# Signed central rules feed (docs/rules-feed.md). Layers: built-in < feed < local (UI edits, LLM drafts).
# Generate the signing key offline with `holealign-server rules keygen -out <file>` and list its public key.
rules:
  feed:
    enabled: false
    # latest.json; https:// required (file:// for mirrors). Empty = only `holealign-server rules import`.
    url: ""
    interval: 6h
    # Base64 ed25519 public keys; required when enabled. List two keys while rotating.
    trusted_keys: []
    # Ready-to-use settings for the public feed (key_id 75eef42e119d4dda; canonical key:
    # https://github.com/DonSosiska/holealign-rules/blob/main/keys/rules-public.key).
    # Compare the key with that file before you trust it, then replace the block above with:
    #   enabled: true
    #   url: https://donsosiska.github.io/holealign-rules/latest.json
    #   interval: 6h
    #   trusted_keys: ["UuFW4nYSCwI3xfHhwapVhYrjYhVO6i7yaxOTv9KFCuM="]
    #   stale_after: 7d
    # feed_stale alert ("rules feed") when no poll succeeded for this long or the last 3 polls failed.
    stale_after: 7d

feeds:
  # How often vulnerability data (Grype DB, KEV, EPSS) is refreshed.
  interval: 6h
  # false disables all network updates (air-gapped hosts, tests).
  update: true

# Silence alerts: an agent that stops checking in, a stale/failing vulnerability feed or a failing
# pipeline is reported to the notify.ops destinations.
alerts:
  # Alert when a host has not checked in for this long. 0 disables agent_silent/agent_back.
  agent_silent_after: 30m
  # Alert when the vulnerability DB was not updated for this long (or refreshing keeps failing).
  # 0 disables feed_stale/feed_ok.
  feed_stale_after: 48h
  # Deprecated alias of notify.ops (still accepted, merged into it).
  ops_rooms: []

# Web UI triage: which unknown findings "need attention" (the rest is "background").
triage:
  # conditions_unknown findings with EPSS >= this (0..1) need attention, besides KEV and
  # Critical/High with a fix available. Env: HOLEALIGN_TRIAGE_EPSS_THRESHOLD.
  epss_threshold: 0.1

# Notification channels. Each is enabled by its section; the secret is read from the environment
# variable it names. Docs: docs/notifications.md.
matrix:
  # Homeserver for alerts, e.g. https://matrix.example.com. Empty disables Matrix.
  homeserver: ""
  # Name of the environment variable holding the bot's access token.
  access_token_env: HOLEALIGN_MATRIX_TOKEN
  # Deprecated aliases of notify.default / notify.routes[].to (still accepted, merged, one WARN):
  default_rooms: []
  routes: []

# Slack: bot token (xoxb-...) with the chat:write scope; the bot must be invited to each channel.
# Uncomment to enable (the variable name must be different from the other *_env names).
# slack:
#   token_env: HOLEALIGN_SLACK_TOKEN

# Telegram: bot token from @BotFather; the bot must be a member of each chat.
# telegram:
#   bot_token_env: HOLEALIGN_TELEGRAM_TOKEN

# Where alerts go. A destination is "scheme:target":
#   Matrix   !abc123:matrix.example.com   (a bare room ID; or matrix:!abc123:matrix.example.com)
#   Slack    slack:C0123456789            (channel ID, not the name)
#   Telegram telegram:-1001234567890      (chat id; telegram:-1001234567890/17 for topic 17)
# Every destination is validated at start; its channel must be configured above.
notify:
  # Used when no label route matches a host.
  default: []
  # Label to destinations. Web UI edits are stored in the database and merged with these.
  # Example:
  #   routes:
  #     - {label: prod,    to: ["!prod:example.com", "slack:C0123456789"]}
  #     - {label: staging, to: ["telegram:-1001234567890/17"]}
  routes: []
  # Server-level events (feed, pipeline, mass silence). Empty: default.
  ops: []

llm:
  # none | anthropic | openai-compatible (e.g. Ollama)
  provider: none
  model: claude-sonnet-5-5
  # openai-compatible only, e.g. http://ollama:11434/v1
  base_url: ""
  # Name of the environment variable holding the API key.
  api_key_env: HOLEALIGN_LLM_API_KEY
  # Maximum rule-drafting calls per day.
  daily_limit: 50

# Agentless mode: the server monitors its own host without a separate holealign-agent. The host
# appears as a normal host (findings, rules, alerts, silence alerts) labelled "server" and marked
# "local (built-in)" in the web UI. No enrollment token is used: the server creates the host record
# itself and stores the agent key in <data_dir>/local-agent/credentials.json (0600).
# If a standalone agent already enrolled this machine the server does NOT take the host over: it logs
# an ERROR (delete that host with `holealign-server host delete <hostname>` or disable local_agent).
local_agent:
  # Off by default. Env: HOLEALIGN_LOCAL_AGENT_ENABLED.
  enabled: false
  # collector: read the host through the root collector's unix socket (recommended: the server stays
  #            unprivileged, the host runs only holealign-collector.service; install.sh --collector-only;
  #            the server must run as the collector's user "holealign", see holealign-server.service).
  # inprocess: collect inside the server process with its own privileges (dev / single box). Fewer facts
  #            when not root (sshd -T, docker.sock ...; one WARN). In a container this scans the container.
  # auto:      collector when the socket answers, else inprocess (the choice is logged).
  source: auto
  collector_socket: /run/holealign/collector.sock
  # Authoritative labels of the local host (locked like enrollment token labels). Changing them is
  # applied at the next server start.
  labels: [server]
  checkin_interval: 5m          # >= 1m
  inventory_interval: 6h        # >= 1m, safety-net rescan; package changes trigger earlier
  scan_language_packages: true
  # Paths excluded from the host scan; empty = the agent defaults (/proc, /sys, /dev, /run, /var/lib/docker, ...).
  # data_dir is always excluded in addition (the scanner must not open the server's own database files).
  exclude_paths: []
  docker_socket: /var/run/docker.sock   # images are scanned if it exists and is readable

# Names in *_env keys (matrix.access_token_env, slack.token_env, telegram.bot_token_env,
# llm.api_key_env, admin.initial_password_env) must
# match ^HOLEALIGN_[A-Z0-9_]+$ and be pairwise different.
# A WARN is logged at startup for http:// public_url / matrix.homeserver / llm.base_url on
# non-loopback hosts.
admin:
  # Name of the environment variable holding the password for user "admin" (min 12 characters).
  # Used only when no web user exists yet (first start). HOLEALIGN_ADMIN_PASSWORD_FILE (a path)
  # is also honoured and takes precedence.
  initial_password_env: HOLEALIGN_ADMIN_PASSWORD
