# Secrets and optional overrides for holealign-server.
#
# systemd: copy to /etc/holealign/server.env (mode 0600).
# docker compose: copy to deploy/.env.
#
# Empty values are ignored. Do not commit the filled-in file.

# Password for the web user "admin", min 12 characters. Used only on first start
# (when no web user exists). Later changes: holealign-server user set-password admin
HOLEALIGN_ADMIN_PASSWORD=
# Alternative: path of a file containing the password (takes precedence; keeps it out of the
# process environment). Example: HOLEALIGN_ADMIN_PASSWORD_FILE=/run/secrets/holealign_admin

# Matrix bot access token (see docs/notifications.md).
HOLEALIGN_MATRIX_TOKEN=

# Notification secrets, one variable per secret (names are set in server.yaml; uncomment what you use).
# HOLEALIGN_SLACK_TOKEN=
# HOLEALIGN_TELEGRAM_TOKEN=
# HOLEALIGN_DISCORD_OPS_URL=https://discord.com/api/webhooks/<id>/<token>
# HOLEALIGN_TEAMS_OPS_URL=https://<region>.logic.azure.com:443/workflows/...
# HOLEALIGN_WEBHOOK_SIEM_SECRET=                        # at least 16 random bytes, e.g. openssl rand -hex 32
# HOLEALIGN_SMTP_PASSWORD=

# API key for the LLM provider (anthropic or openai-compatible). Leave empty for provider none.
HOLEALIGN_LLM_API_KEY=

# Optional non-secret overrides. Uncomment to use.
# HOLEALIGN_PUBLIC_URL=https://holealign.example.com    # base URL of the admin web UI
# HOLEALIGN_ADMIN_LISTEN=127.0.0.1:8081                 # admin web UI listener (agent API: HOLEALIGN_LISTEN)
# HOLEALIGN_TRUSTED_PROXIES=127.0.0.1                   # reverse proxies whose X-Forwarded-For is trusted
# HOLEALIGN_ALERTS_AGENT_SILENT_AFTER=30m               # 0 disables
# HOLEALIGN_ALERTS_FEED_STALE_AFTER=48h                 # 0 disables
# HOLEALIGN_NOTIFY_OPS=!ops:example.com                 # comma separated destinations: !room:server, slack:C0123456789, telegram:-100123, discord:ops, teams:ops, webhook:siem, email:ops@example.com
# HOLEALIGN_MATRIX_HOMESERVER=https://matrix.example.com
# HOLEALIGN_LLM_PROVIDER=openai-compatible
# HOLEALIGN_LLM_MODEL=llama3.1
# HOLEALIGN_LLM_BASE_URL=http://ollama:11434/v1
