# Panoptes server configuration, installed as /etc/panoptes/server.yaml.
# Every key is optional; the values shown are the defaults.
# Secrets are never stored here: they come from environment variables
# (see server.env.example). Any scalar can also be set as PANOPTES_<SECTION>_<KEY>.

# Agent API listener (/api/v1/*, /healthz). Monitored hosts connect here; nothing else is served.
listen: ":8080"

# Admin web UI listener. Keep it on loopback (default) and reach it through an SSH tunnel, a VPN or
# a reverse proxy, so monitored hosts cannot reach the login page. Empty or equal to `listen`
# serves both on one port (legacy; logs a WARNING).
admin_listen: "127.0.0.1:8081"

# Public URL of the admin web UI, used for links in notifications.
public_url: "http://localhost:8081"

# Optional native TLS (both keys of a pair required; TLS 1.2 minimum). Alternative: terminate TLS
# in a reverse proxy.
# tls_cert: /etc/panoptes/agent.crt        # agent API
# tls_key: /etc/panoptes/agent.key
# admin_tls_cert: /etc/panoptes/admin.crt  # admin web UI
# admin_tls_key: /etc/panoptes/admin.key

# CIDRs / IPs of reverse proxies whose X-Forwarded-For header is trusted for the client address
# (rate limiting, audit log). Empty: always the TCP peer address. Never list networks that
# untrusted clients can reach directly.
trusted_proxies: []

# SQLite database and Grype DB cache. Must match StateDirectory in the systemd unit.
data_dir: /var/lib/panoptes

# Shipped exploitability rules (YAML files).
rules_dir: /usr/share/panoptes/rules

feeds:
  # How often vulnerability data (Grype DB, KEV, EPSS) is refreshed.
  interval: 6h
  # false disables all network updates (air-gapped hosts, tests).
  update: true

# Silence alerts: an agent that stops checking in, a stale/failing vulnerability feed or a failing
# pipeline is reported to Matrix.
alerts:
  # Alert when a host has not checked in for this long. 0 disables agent_silent/agent_back.
  agent_silent_after: 30m
  # Alert when the vulnerability DB was not updated for this long (or refreshing keeps failing).
  # 0 disables feed_stale/feed_ok.
  feed_stale_after: 48h
  # Rooms for server-level events (feed, pipeline, mass silence). Empty: matrix.default_rooms.
  ops_rooms: []

matrix:
  # Homeserver for alerts, e.g. https://matrix.example.com. Empty disables Matrix.
  homeserver: ""
  # Name of the environment variable holding the bot's access token.
  access_token_env: PANOPTES_MATRIX_TOKEN
  # Rooms used when no label route matches, e.g. ["!abc:example.com"].
  default_rooms: []
  # Label to rooms. Web UI edits are stored in the database and merged with these.
  # Example:
  #   routes:
  #     - {label: prod, rooms: ["!prod:example.com"]}
  routes: []

llm:
  # none | anthropic | openai-compatible (e.g. Ollama)
  provider: none
  model: claude-sonnet-5-5
  # openai-compatible only, e.g. http://ollama:11434/v1
  base_url: ""
  # Name of the environment variable holding the API key.
  api_key_env: PANOPTES_LLM_API_KEY
  # Maximum rule-drafting calls per day.
  daily_limit: 50

# Names in *_env keys must match ^PANOPTES_[A-Z0-9_]+$ and differ from the admin password variable.
# A WARN is logged at startup for http:// public_url / matrix.homeserver / llm.base_url on
# non-loopback hosts.
admin:
  # Min 12 characters; PANOPTES_ADMIN_PASSWORD_FILE (path) is also honoured. Environment variable with the password for user "admin". Used only when no
  # web user exists yet (first start).
  initial_password_env: PANOPTES_ADMIN_PASSWORD
