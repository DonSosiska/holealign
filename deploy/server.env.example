# Secrets and optional overrides for panoptes-server.
#
# systemd: copy to /etc/panoptes/server.env (mode 0600).
# docker compose: copy to deploy/.env.
#
# Empty values are ignored. Do not commit the filled-in file.

# Password for the web user "admin", min 8 characters. Used only on first start
# (when no web user exists). Later changes: panoptes-server user set-password admin
PANOPTES_ADMIN_PASSWORD=

# Matrix bot access token (see README, "Matrix setup").
PANOPTES_MATRIX_TOKEN=

# API key for the LLM provider (anthropic or openai-compatible). Leave empty for provider none.
PANOPTES_LLM_API_KEY=

# Optional non-secret overrides. Uncomment to use.
# PANOPTES_PUBLIC_URL=https://panoptes.example.com
# PANOPTES_MATRIX_HOMESERVER=https://matrix.example.com
# PANOPTES_LLM_PROVIDER=openai-compatible
# PANOPTES_LLM_MODEL=llama3.1
# PANOPTES_LLM_BASE_URL=http://ollama:11434/v1
